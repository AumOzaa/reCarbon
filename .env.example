# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/recarbon

# JWT Configuration
JWT_SECRET=your_super_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Application
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Ollama Configuration (for embeddings)
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=embeddinggemma:latest

# Ollama Cloud Configuration (for LLM CAS extraction)
OLLAMA_CLOUD_URL=https://api.ollama.ai/api
LLM_MODEL=gpt-oss:120b-cloud

# Pinecone Configuration (for vector search)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=recarbon-selling-materials
