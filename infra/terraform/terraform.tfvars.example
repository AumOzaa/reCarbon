aws_region   = "ap-south-1"
environment  = "production"
instance_type = "t3.micro"

instance_name = "recarbon-backend"

ssh_key_name = "recarbon-backend-key"

# Replace this with your PUBLIC SSH key.
#
# Example:
# ssh_public_key = "ssh-ed25519 AAAAC3... your-email@example.com"
ssh_public_key = "YOUR_PUBLIC_SSH_KEY"

# IMPORTANT:
# Replace this with YOUR public IP.
#
# Find it with:
# curl https://checkip.amazonaws.com
#
# Example:
# allowed_ssh_cidr = "49.36.123.456/32"
allowed_ssh_cidr = "YOUR_IP/32"

app_port = 3000
